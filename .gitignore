node_modules/
.backup/

# Private runtime state and generated logs.
# Anchored to repo root: a bare `goal/`/`state/` also matches plugins/goal/ and
# any nested */state/ source dir, which silently dropped plugins/goal/*.ts from the
# publish and broke the Validate Harness typecheck. Keep these root-only.
/goal/
/state/
*.log
*.jsonl
**/.opencode/state/
.opencode/
.superpowers/

# Local credentials and machine-specific overrides.
.env
.env.*
!.env.example
*.local.json
*.local.jsonc
*.secret

# Docusaurus documentation site (website/) build artifacts.
website/build/
website/.docusaurus/
website/node_modules/
